# Copy to .env and edit. .env is gitignored, so it survives every git pull and
# is never committed.
#
#   cp .env.example .env

# The hostname Traefik should route. Required — there is no default.
RACE_HOST=race.local.example.com

# The existing external docker network Traefik watches. Confirm with
# `docker network ls`. Get this wrong and `up` fails outright with "network
# declared as external, but could not be found" — which at least is loud.
TRAEFIK_NETWORK=proxy

# Traefik's https entrypoint name, as named in ITS config, not a convention.
# Traefik's own docs use "websecure"; plenty of setups use "https".
#
# Get this wrong and NOTHING tells you: a router pointing at an entrypoint
# that does not exist is dropped silently, never appears on the dashboard,
# and the hostname simply does not resolve to the service. Copy the value
# from a container Traefik already routes successfully.
ENTRYPOINT=https

# Where the parquet lives, if not ./data. titles + edges are required;
# redirects (alias search) and nodes (the map) are optional.
# DATA_DIR=/srv/wiki-graph/data

# Only for a public deploy. Also uncomment the certresolver label in
# docker-compose.game.yml — on its own this variable does nothing. Leave both
# alone when Traefik already holds a wildcard certificate for RACE_HOST.
# CERT_RESOLVER=le
