# Massive data files
data/
*.xml
*.bz2
*.csv
*.parquet

# Rust build artifacts
target/
# NOT Cargo.lock — Dockerfile.game copies it so the image builds the exact
# dependency versions that were tested. Excluding a lockfile from the build
# context makes release builds non-reproducible, and here it simply broke the
# COPY.

# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
.env

# IDE
.vscode/
.idea/

# Logs
*.log

# Gemini notes
*.md
!README.md
